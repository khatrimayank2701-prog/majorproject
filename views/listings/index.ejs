<% layout("/layouts/boilerplate") %>

<div id="filters">

  <a href="/listing?category=Trending" class="filter">
    <div>
      <i class="fa-solid fa-fire"></i>
    </div>
    <p>Trending</p>
  </a>

  <a href="/listing?category=Rooms" class="filter">
    <div>
      <i class="fa-solid fa-bed"></i>
    </div>
    <p>Rooms</p>
  </a>

  <a href="/listing?category=Beach" class="filter">
    <div>
      <i class="fa-solid fa-umbrella-beach"></i>
    </div>
    <p>Beach</p>
  </a>

  <a href="/listing?category=Popular%20Cities" class="filter">
    <div>
      <i class="fa-solid fa-city"></i>
    </div>
    <p>Popular Cities</p>
  </a>

  <a href="/listing?category=Amazing%20Views" class="filter">
    <div>
      <i class="fa-solid fa-mountain-sun"></i>
    </div>
    <p>Amazing Views</p>
  </a>

  <a href="/listing?category=Farms" class="filter">
    <div>
      <i class="fa-solid fa-house-chimney-window"></i>
    </div>
    <p>Farms</p>
  </a>

  <a href="/listing?category=Lakefront" class="filter">
    <div>
      <i class="fa-solid fa-water"></i>
    </div>
    <p>Lakefront</p>
  </a>

  <a href="/listing?category=Skiing" class="filter">
    <div>
      <i class="fa-solid fa-person-skiing"></i>
    </div>
    <p>Skiing</p>
  </a>

  <a href="/listing?category=Forest" class="filter">
    <div>
      <i class="fa-solid fa-tree"></i>
    </div>
    <p>Forest</p>
  </a>

  <a href="/listing?category=Cabins" class="filter">
    <div>
      <i class="fa-solid fa-house"></i>
    </div>
    <p>Cabins</p>
  </a>

  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
</div>
  </div>
</div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
<% for(let listing of alllistings) { %>
<a href="/listing/<%= listing._id %>" class="Listing-link">
  <div class="card col" style="width: 20rem;">
  
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
  <div class="card-body">
    <p class="card-text">
        <%= listing.title %>
        <br>
        &#8377; <%= listing.price.toLocaleString("en-IN") %> /night &nbsp;<i class="tax-info">+18% GST</i>
    </p>
  </div>
</div>
</a>
<% } %>
</div>

<script>
  let togglebtn=document.getElementById("switchCheckDefault");
  togglebtn.addEventListener("click",()=>{
    let taxinf=document.getElementsByClassName("tax-info");
    for(info of taxinf){
      if(togglebtn.checked){
        info.style.display="inline";
      }
      else{
        info.style.display="none";
      }
  }
    
  })
</script>

<script>

